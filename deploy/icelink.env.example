# Ice-Link 서버 환경 변수 템플릿
# 서버의 /home/fbwoals/icelink.env 로 복사한 뒤 값을 채운다.
#   cp icelink.env.example /home/fbwoals/icelink.env
#   chmod 600 /home/fbwoals/icelink.env
# 이 파일(example)만 커밋하고, 실제 값이 든 icelink.env 는 절대 커밋하지 않는다.

# ---- Database ----
# DB가 같은 서버에 있으면 localhost. 접속이 안 되면 fbwoalszz.iptime.org 로 바꾼다.
ICELINK_DB_HOST=localhost
ICELINK_DB_PORT=5432
ICELINK_DB_NAME=kosscchthon
ICELINK_DB_USER=fbwoals
ICELINK_DB_PASSWORD=

# ---- AI Gateway (국민대) ----
ICELINK_AI_API_KEY=

# ---- Server ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
