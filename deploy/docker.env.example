# deploy.sh 변수. 서버의 /home/fbwoals/icelink/.env 로 복사한다.
#   cp docker.env.example /home/fbwoals/icelink/.env
# 앱 비밀값(DB 비밀번호, AI 키)은 여기가 아니라 /home/fbwoals/icelink.env 에 있다.

# Docker Hub 계정. 이미지 이름은 <계정>/icelink-backend, <계정>/icelink-frontend
DOCKERHUB_USERNAME=

# 기본 이미지 태그. 평소 latest. 롤백은 ./deploy.sh backend sha-<커밋해시 앞 7자리> 처럼 인자로 준다
TAG=latest
